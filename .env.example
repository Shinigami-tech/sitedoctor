# Vultr Serverless Inference (OpenAI-compatible). Leave the key empty to run in rules mode.
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_KEY=
VULTR_MODEL=
# Public address of this VM (used for the demo patient link)
SD_PUBLIC_URL=http://YOUR_VM_IP:8080
PORT=8080
# Hosts the sandbox may reach even though they are private (the demo patient lives on the host)
SD_ALLOW_HOSTS=172.17.0.1
SD_MAX_PARALLEL=2
